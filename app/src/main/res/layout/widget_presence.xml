<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" android:importantForAccessibility="no" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/widget_session"
        android:src="@drawable/ic_w_ring" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans_3"
            android:textColor="@color/widget_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_plain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans_3"
            android:textColor="@color/widget_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans_3"
            android:textColor="@color/widget_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/source_sans_3"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="104dp" android:layout_height="48dp">
        <ImageView android:id="@+id/widget_action_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_action_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/source_sans_3"
        android:gravity="center"
        android:minWidth="72dp"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/widget_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>

</FrameLayout>
